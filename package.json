{
  "name": "hexfin",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && expo install --check",
    "export:web": "expo export --platform web",
    "preview:web": "node scripts/serve-static.cjs",
    "server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=server/.env server/index.ts",
    "verify": "npm run check && npm run export:web",
    "app:build": "node scripts/release.cjs",
    "app:release": "node scripts/release.cjs --publish"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@expo-google-fonts/geist": "0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
