# Copie para server/.env (ignorado pelo Git) e preencha. Nunca use EXPO_PUBLIC_* para segredos.
AI_API_KEY=
# Padrão: claude-opus-5-5. Alternativa mais barata: claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Opcional: endpoint alternativo compatível com a API da Anthropic
AI_BASE_URL=
AI_TIMEOUT_MS=15000
# Token que o app envia em Authorization: Bearer (mínimo 24 caracteres)
HEXFIN_APP_TOKEN=
PORT=8787
# 127.0.0.1 só aceita conexões locais; use 0.0.0.0 atrás de um proxy HTTPS
HOST=127.0.0.1
# Origem liberada no CORS para a prévia Web (ex.: http://127.0.0.1:4173)
AI_ALLOWED_ORIGIN=
AI_RATE_LIMIT_PER_MINUTE=30
